{
  "name": "clash-harmony-api",
  "version": "1.0.0",
  "description": "Cloudflare login and protected configuration service for Clash Harmony",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test",
    "check": "node --check gateway/public/_worker.js && node --check scripts/account.mjs && node --check scripts/config.mjs && node --check scripts/operations.mjs && npm run typecheck && npm test && npm run test:scripts",
    "deploy": "wrangler deploy --config wrangler.local.jsonc",
    "account": "node scripts/account.mjs",
    "config": "node scripts/config.mjs",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "bundle-check": "wrangler deploy --dry-run --config wrangler.jsonc",
    "secret": "wrangler secret put BETTER_AUTH_SECRET --config wrangler.local.jsonc",
    "migrate": "wrangler d1 migrations apply DB --remote --config wrangler.local.jsonc"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "dependencies": {
    "better-auth": "^1.7.7",
    "kysely-d1": "^0.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^26.6.5",
    "auth": "^1.7.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
