{
  "profile": {
    "proxies": [
      {
        "name": "example",
        "type": "trojan",
        "server": "proxy.example.com",
        "port": 443,
        "password": "REPLACE_ME",
        "sni": "proxy.example.com"
      }
    ],
    "proxy-groups": [
      {
        "name": "Auto",
        "type": "select",
        "proxies": [
          "example"
        ]
      }
    ],
    "dns": {
      "enable": true,
      "enhanced-mode": "fake-ip",
      "nameserver": [
        "https://dns.alidns.com/dns-query"
      ]
    },
    "rules": [
      "GEOSITE,cn,DIRECT",
      "GEOIP,CN,DIRECT",
      "MATCH,Auto"
    ]
  },
  "runtime": {
    "announcement": "服务公告示例",
    "texts": {
      "ready": "点击连接",
      "running": "已连接",
      "login": "登录"
    },
    "defaults": {
      "showReconnectHint": true
    },
    "features": {
      "nodeSwitcher": true,
      "manualRefresh": true
    },
    "parameters": {
      "checkSeconds": 300,
      "refreshSeconds": 86400
    }
  }
}