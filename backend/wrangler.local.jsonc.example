{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clash-harmony-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "AUTH_ORIGIN": "https://YOUR-PAGES-OR-WORKERS-ORIGIN.example"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clash-harmony-auth",
      "database_id": "YOUR-D1-DATABASE-UUID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
